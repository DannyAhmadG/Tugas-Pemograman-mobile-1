<div class="form-group col-md-4">
<label for="pekerjaanIbu" class="font-weight-bold">Pekerjaan Ibu</label>
<input type="text" class="form-control" id="pekerjaanIbu" name="pekerjaanIbu"
placeholder="Pekerjaan Ibu">
</div>
<div class="form-group col-md-4">
<label for="alamatIbu" class="font-weight-bold">Alamat Ibu</label>
<input type="text" class="form-control" id="alamatIbu" name="alamatIbu"
placeholder="Alamat Ibu">
</div>
</div>
